@model UrunEditModel

@{
    Layout = "_AdminLayout";
}

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<form asp-controller="Urun" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id">

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Ürün Düzenle</h5>
                    <a asp-controller="Urun" asp-action="Index" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-list"></i>
                    </a>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label asp-for="UrunAdi" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="UrunAdi" class="form-control">
                            <span asp-validation-for="UrunAdi" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Aciklama" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <textarea asp-for="Aciklama" class="form-control"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Fiyat" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Fiyat" class="form-control">
                            <span asp-validation-for="Fiyat" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Aktif" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10 d-flex align-items-center">
                            <input asp-for="Aktif" class="form-check-input">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Anasayfa" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10 d-flex align-items-center">
                            <input asp-for="Anasayfa" class="form-check-input">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="KategoriId" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="KategoriId" class="form-select">
                                <option value="">Seçiniz</option>
                                @foreach (var kategori in ViewBag.Kategoriler)
                                {
                                    <option value="@kategori.Id">@kategori.KategoriAdi</option>
                                }
                            </select>
                            <span asp-validation-for="KategoriId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header py-1">
                    <h5 class="card-title">Ürün Resmi</h5>
                </div>
                <div class="card-body">
                    <img src="~/img/@Model.ResimAdi" class="img-thumbnail mb-3 w-100" alt="">

                    <label asp-for="Resim" class="form-label"></label>
                    <input asp-for="Resim" class="form-control">
                    <span asp-validation-for="Resim" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
</form>
